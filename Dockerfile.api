# -------------------------------------------------------------
# Stage 1: Build TypeScript source
# -------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root and workspace manifests for dependency caching
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm ci

# Copy full monorepo source
COPY . .

# Build API TypeScript output
RUN npm run build:api

# -------------------------------------------------------------
# Stage 2: Production Runner
# -------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

# Copy manifests to install production dependencies only
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm ci --omit=dev --workspace=@lector/api

# Copy compiled JavaScript output
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy runtime assets: OpenAPI spec (to both paths for cwd resilience) and database migrations
COPY --from=builder /app/apps/api/openapi ./openapi
COPY --from=builder /app/apps/api/openapi ./apps/api/openapi
COPY --from=builder /app/apps/api/migrations ./apps/api/migrations

# Create persistent storage folder for local audio recordings and adjust ownership
RUN mkdir -p /app/apps/api/storage/audio && chown -R node:node /app

USER node

# Set working directory to apps/api so process.cwd() resolves ./openapi/spec.yaml
WORKDIR /app/apps/api

EXPOSE 3000

CMD ["node", "dist/server.js"]
