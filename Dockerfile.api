# -------------------------------------------------------------
# Stage 1: Build
# -------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root and package manifests for clean caching
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm ci

# Copy full monorepo source
COPY . .

# Build API TypeScript output
RUN npm run build:api

# -------------------------------------------------------------
# Stage 2: Production Runner
# -------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/

# Install only production dependencies
RUN npm ci --omit=dev --workspace=@lector/api

# Copy compiled code from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/

# Create persistent storage folder for audio recordings
RUN mkdir -p /app/apps/api/storage/audio && chown -R node:node /app

USER node

EXPOSE 3000

CMD ["node", "apps/api/dist/server.js"]
